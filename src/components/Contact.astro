---
interface Props {
	whatsappNumber?: string;
	whatsappMessage?: string;
}

const {
	whatsappNumber = "593992084976",
	whatsappMessage = "Buen día. Me interesa conocer más sobre los costos de la presentación de mariachi para un evento."
} = Astro.props;

const digits = whatsappNumber.replace(/\D/g, '');
const whatsappUrl = `https://wa.me/${digits}?text=${encodeURIComponent(whatsappMessage)}`;
const telHref = `tel:+${digits}`;
const telLabel = '+593 99 208 4976';

const inicioFecha = new Date(2009, 10, 1); // 1 de noviembre de 2009
const hoy = new Date();
const anosExperiencia = Math.floor((hoy.getTime() - inicioFecha.getTime()) / (365.25 * 24 * 60 * 60 * 1000));

const intro = `Somos un grupo de mariachi con ${anosExperiencia} años de experiencia llevando la música tradicional mexicana a los momentos más especiales de tu vida.`;

const cards = [
	{
		title: 'Música Mexicana',
		description: 'Rancheras, boleros, sones y huapangos del repertorio tradicional.',
	},
	{
		title: 'Para toda ocasión',
		groups: [
			{ label: 'Amor', items: 'Serenatas, matrimonios y bodas de oro' },
			{ label: 'Familia', items: 'Cumpleaños, bautizos y despedidas' },
			{ label: 'Eventos', items: 'Particulares y públicos' },
		],
	},
	{
		title: 'Cobertura',
		description: 'Presentaciones dentro y fuera de la ciudad. El precio incluye transporte y amplificación.',
	},
];

const social = [
	{
		name: 'Facebook',
		url: 'https://www.facebook.com/mexicolindoambato',
		modifier: 'facebook',
		path: 'M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z',
	},
	{
		name: 'Instagram',
		url: 'https://www.instagram.com/mexicolindoambato?utm_source=ig_web_button_share_sheet&igsh=ZDNlZDc0MzIxNw==',
		modifier: 'instagram',
		path: 'M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z',
	},
	{
		name: 'YouTube',
		url: 'https://www.youtube.com/@mariachimexicolindoambato7998',
		modifier: 'youtube',
		path: 'M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z',
	},
