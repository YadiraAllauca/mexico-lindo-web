---

<section id="contacto" class="contact">
	<div class="wrap">
		<div class="contact-top">
			<div class="contact-head">
				<h2 class="section-title">Contáctanos</h2>
				<span class="greca-rule" aria-hidden="true"></span>
			</div>
			<p class="contact-intro">{intro}</p>
		</div>

		<div class="contact-details">
			{cards.map((card) => (
				<div class="detail-item">
					<h3>{card.title}</h3>
					{card.description && <p>{card.description}</p>}
					{card.groups && (
						<dl class="detail-groups">
							{card.groups.map((group) => (
								<div class="detail-group">
									<dt>{group.label}</dt>
									<dd>{group.items}</dd>
								</div>
							))}
						</dl>
					)}
				</div>
			))}
		</div>

		<span class="contact-band" aria-hidden="true"></span>

		<div class="contact-actions">
			<div class="contact-reach">
				<a href={whatsappUrl} target="_blank" rel="noopener noreferrer" data-whatsapp class="contact-whatsapp">
				<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
				</svg>
				<span>Escríbenos por WhatsApp</span>
				</a>

				<p class="contact-call">
					<span class="contact-call-label">O llámanos al mismo número</span>
					<a href={telHref} class="contact-phone">{telLabel}</a>
					<span class="contact-call-name">Sergio Allauca, director</span>
				</p>
			</div>

			<div class="contact-social">
				<p class="contact-social-title">Síguenos en redes</p>
				<div class="contact-social-links">
					{social.map((item) => (
						<a
							href={item.url}
							target="_blank"
							rel="noopener noreferrer"
							class={`contact-social-link contact-social-link--${item.modifier}`}
							aria-label={item.name}
						>
							<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={item.path}/></svg>
						</a>
					))}
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.contact {
		background: var(--papel);
		padding-block: var(--seccion);
	}

	.contact-top {
		display: grid;
		grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
		gap: clamp(2rem, 5vw, 5rem);
		align-items: start;
	}

	.contact-intro {
		font-size: clamp(1.15rem, 1rem + 0.6vw, 1.45rem);
		line-height: 1.62;
		color: var(--texto);
		max-width: 42ch;
	}

	.contact-details {
		margin-top: clamp(3rem, 6vw, 5rem);
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: clamp(1.75rem, 3.5vw, 3rem);
	}

	/* Sin tarjetas ni sombras: basta un filete para separar */
	.detail-item {
		padding-top: 1.25rem;
		border-top: 1px solid var(--linea);
	}

	.detail-item h3 {
		font-size: 1.15rem;
		font-variation-settings: 'wdth' 108;
		color: var(--tinta);
		margin-bottom: 0.6rem;
	}

	.detail-item p {
		color: var(--texto-tenue);
		font-size: 1rem;
		line-height: 1.65;
		max-width: 34ch;
	}

	/* Las ocasiones se agrupan: matrimonio y serenata son lo mismo, amor */
	.detail-groups {
		display: grid;
		gap: 0.65rem;
		max-width: 34ch;
	}

	.detail-group dt {
		font-family: var(--display);
		font-size: 0.82rem;
		font-weight: 600;
		color: var(--tinta);
	}

	.detail-group dd {
		margin: 0;
		color: var(--texto-tenue);
		font-size: 1rem;
		line-height: 1.5;
	}

	/* La greca separa lo que somos de cómo llegar a nosotros */
	.contact-band {
		display: block;
		height: 22px;
		margin-top: clamp(3.5rem, 7vw, 6rem);
		background-color: var(--mono);
		-webkit-mask-image: var(--greca);
		mask-image: var(--greca);
		-webkit-mask-repeat: repeat-x;
		mask-repeat: repeat-x;
		-webkit-mask-size: auto 22px;
		mask-size: auto 22px;
		opacity: 0.65;
	}

	.contact-actions {
		margin-top: clamp(2.5rem, 5vw, 3.5rem);
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: clamp(2rem, 5vw, 4rem);
		align-items: end;
	}

	.contact-whatsapp {
		display: inline-flex;
		align-items: center;
		gap: 0.7rem;
		padding: 1.05rem 1.75rem;
		background: var(--mono);
		color: #fff;
		text-decoration: none;
		font-family: var(--display);
		font-weight: 600;
		font-size: 1.05rem;
		transition: background-color 0.2s ease;
	}

	.contact-whatsapp:hover { background: var(--mono-hondo); }

	.contact-whatsapp svg {
		width: 22px;
		height: 22px;
		flex-shrink: 0;
	}

	.contact-call {
		margin-top: 1.75rem;
	}

	.contact-call-label {
		display: block;
		font-family: var(--display);
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--texto-tenue);
		margin-bottom: 0.35rem;
	}

	.contact-phone {
		display: inline-block;
		font-family: var(--display);
		font-weight: 800;
		font-variation-settings: 'wdth' 108;
		font-size: clamp(1.3rem, 1.05rem + 0.8vw, 1.7rem);
		letter-spacing: -0.015em;
		color: var(--tinta);
		text-decoration: none;
		border-bottom: 2px solid transparent;
		transition: border-color 0.2s ease;
	}

	.contact-phone:hover {
		border-bottom-color: var(--mono);
	}

	/* Quién contesta */
	.contact-call-name {
		display: block;
		margin-top: 0.4rem;
		font-family: var(--display);
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--texto-tenue);
	}

	.contact-social-title {
		font-family: var(--display);
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--texto-tenue);
		margin-bottom: 0.9rem;
	}

	.contact-social-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
	}

	.contact-social-link {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 52px;
		height: 52px;
		border: 1px solid var(--linea);
		color: var(--tinta);
		transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
	}

	.contact-social-link:hover {
		color: #fff;
		border-color: transparent;
	}

	.contact-social-link svg {
		width: 23px;
		height: 23px;
	}

	.contact-social-link--facebook:hover { background: #1877f2; }
	.contact-social-link--instagram:hover { background: linear-gradient(45deg, #f09433, #dc2743, #bc1888); }
	.contact-social-link--youtube:hover { background: #ff0000; }

	@media (max-width: 860px) {
		.contact-top,
		.contact-actions {
			grid-template-columns: 1fr;
			gap: 1.75rem;
		}

		.contact-intro { max-width: 100%; }

		.contact-actions { align-items: start; }
	}
</style>
