---
import logoMark from '../assets/ml_logo_icon.jpg';

interface Props {
	name?: string;
	imageUrl?: string;
	whatsappNumber?: string;
	whatsappMessage?: string;
}

const {
	name = "Mariachi México Lindo",
	imageUrl = logoMark.src,
	whatsappNumber = "593992084976",
	whatsappMessage = "Buen día. Me interesa conocer más sobre los costos de la presentación de mariachi para un evento."
} = Astro.props;

const whatsappUrl = `https://wa.me/${whatsappNumber.replace(/\D/g, '')}?text=${encodeURIComponent(whatsappMessage)}`;

const [firstWord, ...restWords] = name.trim().split(/\s+/);
const secondLine = restWords.join(' ');
---

<section id="inicio" class="hero">
	<div class="hero-inner wrap">
		<div class="hero-copy">
			<h1 class="hero-title">
				<span class="hero-title-line">{firstWord}</span>
				{secondLine && <span class="hero-title-line">{secondLine}</span>}
			</h1>
			<p class="hero-subtitle">Música mexicana para tus mejores momentos</p>
			<div class="hero-cta">
				<a href={whatsappUrl} target="_blank" rel="noopener noreferrer" data-whatsapp class="hero-whatsapp">
					<svg class="hero-whatsapp-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
					</svg>
					<span>Escríbenos por WhatsApp</span>
				</a>

				<a href="#galeria" class="hero-videos">
					<svg class="hero-videos-icon" viewBox="0 0 24 24" aria-hidden="true">
						<circle cx="12" cy="12" r="9.25" fill="none" stroke="currentColor" stroke-width="1.6"/>
						<path d="M10 8.2l6 3.8-6 3.8z" fill="currentColor"/>
					</svg>
					<span>Ver videos</span>
				</a>
			</div>
		</div>

		<div class="hero-mark">
			<img src={imageUrl} alt={`Logotipo de ${name}`} width="1024" height="796" fetchpriority="high" />
		</div>
	</div>

	<span class="hero-band" aria-hidden="true"></span>
</section>

<style>
	.hero {
		position: relative;
		min-height: 100svh;
		display: flex;
		align-items: center;
		padding-block: calc(var(--barra) + 2rem) clamp(4rem, 9vw, 7rem);
		background: var(--tinta);
		overflow: hidden;
	}

	.hero-inner {
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
		align-items: center;
		gap: clamp(2rem, 6vw, 5rem);
	}

	.hero-title {
		font-size: clamp(2.6rem, 1rem + 7.4vw, 6.2rem);
		font-variation-settings: 'wdth' 104;
		text-transform: uppercase;
		letter-spacing: -0.022em;
		line-height: 0.92;
		color: var(--papel-alto);
		margin: 0;
	}

	.hero-title-line { display: block; }

	.hero-subtitle {
		margin-top: clamp(1.5rem, 3vw, 2.2rem);
		font-size: clamp(1.05rem, 0.9rem + 0.6vw, 1.35rem);
		line-height: 1.5;
		color: rgba(236, 238, 230, 0.86);
		max-width: 30ch;
	}

	.hero-cta {
		margin-top: clamp(1.35rem, 3vw, 2.4rem);
		display: flex;
		flex-direction: column;
		align-items: stretch;
		width: fit-content;
		max-width: 100%;
		gap: 0.75rem;
	}

	.hero-whatsapp {
		display: inline-flex;
		align-items: center;
		gap: 0.7rem;
		padding: 0.95rem 1.6rem;
		background: var(--mono);
		color: #fff;
		text-decoration: none;
		font-family: var(--display);
		font-weight: 600;
		font-size: 1.02rem;
		transition: background-color 0.2s ease;
	}

	.hero-whatsapp:hover { background: var(--mono-hondo); }

	.hero-whatsapp-icon {
		width: 22px;
		height: 22px;
		flex-shrink: 0;
	}

	/* Acción secundaria: misma caja que el botón principal, sin peso de color */
	.hero-videos {
		display: inline-flex;
		align-items: center;
		gap: 0.7rem;
		padding: 0.95rem 1.6rem;
		border: 1px solid rgba(236, 238, 230, 0.4);
		color: var(--papel);
		text-decoration: none;
		font-family: var(--display);
		font-weight: 600;
		font-size: 1.02rem;
		transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
	}

	.hero-videos:hover {
		background: var(--papel-alto);
		border-color: var(--papel-alto);
		color: var(--tinta);
	}

	.hero-videos-icon {
		width: 22px;
		height: 22px;
		flex-shrink: 0;
	}

	/* El logotipo es un JPG negro sobre blanco. Se umbraliza y se invierte para
	   dejarlo en blanco, y screen borra el fondo negro resultante. El blend va
	   en el contenedor: si comparte elemento con la animación, el transform
	   crea un contexto de apilamiento y el recuadro vuelve a aparecer. */
	.hero-mark {
		justify-self: center;
		filter: grayscale(1) contrast(4) invert(1);
		mix-blend-mode: screen;
	}

	.hero-mark img {
		width: min(118%, 560px);
		height: auto;
	}

	/* Banda de greca a pie de sección: el único adorno, y viene del propio logotipo */
	.hero-band {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 22px;
		background-color: var(--mono);
		-webkit-mask-image: var(--greca);
		mask-image: var(--greca);
		-webkit-mask-repeat: repeat-x;
		mask-repeat: repeat-x;
		-webkit-mask-size: auto 22px;
		mask-size: auto 22px;
		opacity: 0.4;
	}

	/* Una sola entrada orquestada al cargar la página */
	.hero-title-line,
	.hero-subtitle,
	.hero-whatsapp,
	.hero-videos,
	.hero-mark img {
		animation: heroIn 0.7s cubic-bezier(0.22, 0.7, 0.3, 1) backwards;
	}

	.hero-mark img { animation-delay: 0.05s; }
	.hero-title-line:nth-child(1) { animation-delay: 0.12s; }
	.hero-title-line:nth-child(2) { animation-delay: 0.2s; }
	.hero-subtitle { animation-delay: 0.38s; }
	.hero-whatsapp { animation-delay: 0.46s; }
	.hero-videos { animation-delay: 0.54s; }

	@keyframes heroIn {
		from { opacity: 0; transform: translateY(14px); }
		to { opacity: 1; transform: none; }
	}

	@media (max-width: 860px) {
		.hero {
			/* Sin 100svh: el contenido apilado ocupa menos que la pantalla y
			   forzar la altura dejaba un vacío grande bajo los botones. */
			min-height: auto;
			align-items: flex-start;
			padding-block: calc(var(--barra) + 1.5rem) clamp(2.5rem, 8vw, 5rem);
		}

		.hero-inner {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}

		.hero-mark {
			order: -1;
			justify-self: start;
		}

		.hero-mark img {
			width: min(52%, 220px);
		}

		.hero-subtitle { max-width: 34ch; }
	}
</style>
